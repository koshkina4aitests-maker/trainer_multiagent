# Copy to .env.production and fill in real values (chmod 600)
# This file is safe to commit — it contains no secrets.
FITNESS_APP_NAME=Fitness App Backend
FITNESS_API_V1_PREFIX=/v1
FITNESS_DATABASE_URL=sqlite:////opt/fitness-app/data/fitness.db
FITNESS_REDIS_URL=redis://redis:6379/0
FITNESS_CELERY_BROKER_URL=redis://redis:6379/1
FITNESS_CELERY_RESULT_BACKEND=redis://redis:6379/2
FITNESS_CELERY_TASK_ALWAYS_EAGER=false
